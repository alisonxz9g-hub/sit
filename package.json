{
  "name": "haze-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first video optimizer for TikTok uploads. Analyzes MP4/MOV structure and rebuilds it for the platform's encoder without leaving the browser.",
  "scripts": {
    "postinstall": "node scripts/sync-ffmpeg.mjs",
    "vendor": "node scripts/sync-ffmpeg.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "pretest": "node scripts/build-test-bundle.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
