{
  "name": "haze-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first video optimizer for TikTok uploads. Analyzes MP4/MOV structure and rebuilds it for the platform's encoder without leaving the browser.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/sync-ffmpeg.mjs",
    "vendor": "node scripts/sync-ffmpeg.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "smoke": "node scripts/smoke-dist.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "explain": "node scripts/explain.mjs",
    "try-remux": "node scripts/try-remux.mjs",
    "compare": "node scripts/compare.mjs",
    "timing": "node scripts/timing-table.mjs",
    "pretest": "node scripts/build-test-bundle.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
